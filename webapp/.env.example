# Copy this file to .env and fill in real values. Never commit .env itself.

# ---- Live sentiment tester ----
# "local" = load both transformer models into this process (needs ~2.5GB RAM, always works,
#           this is the default and what you want for local dev/testing)
# "api"   = call Hugging Face's Inference API instead (near-zero RAM, needs HF_TOKEN below —
#           only switch to this if you deploy somewhere with limited RAM; TEST it works before
#           relying on it, community fine-tunes aren't always hosted by an Inference Provider)
SENTIMENT_MODE=local
HF_TOKEN=

# ---- Owner AI assistant (Groq) ----
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
# Verify this model string is still current at https://console.groq.com/docs/models before
# deploying — Groq's lineup has been rotating through 2026 (llama-3.1-8b-instant and
# llama-3.3-70b-versatile both got deprecation notices; openai/gpt-oss-120b is their current
# recommended migration target as of this writing)
GROQ_MODEL=openai/gpt-oss-120b
